# Local Python environments, caches, and build outputs
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
.coverage
htmlcov/

# Local machine configuration and editor files
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*.pptx
*.log

# Third-party downloads and machine-specific preparation. Recreate with `prepare`.
/inputs/raw/
/inputs/processed/

# Local presentation copies of third-party data and derived previews.
# README.md and MANIFEST.json under datasets/ remain shareable.
/datasets/originals/
/datasets/processed/
/datasets/previews/

# Only the checked-in reference checkpoints and experiment campaigns are shared.
/artifacts/*
!/artifacts/gnn.pt
!/artifacts/gnn.json
!/artifacts/gnn_test_forecasts.npz
!/artifacts/gru.pt
!/artifacts/gru.json
!/artifacts/gru_test_forecasts.npz
!/artifacts/persistence.json
!/artifacts/training_summary.json
!/artifacts/training.csv
!/artifacts/forecast_metrics.csv
!/artifacts/abilene/
!/artifacts/abilene/**

/results/*
!/results/demo/
!/results/demo/**
!/results/paper/
!/results/paper/**
!/results/abilene/
!/results/abilene/summary.csv
!/results/abilene/paired_differences.csv
!/results/abilene/forecast_metrics.csv
!/results/abilene/training_summary.json
!/results/abilene/manifest.json
/results/abilene/runs/

# Transfer bundles, local integrity experiments, and temporary work
/dist/
/.scratch/
/.presentation-build/

# Locally downloaded third-party papers; retain links and citation notes in Git.
/docs/references/papers/
