# Transfer bundles, local integrity experiments, and temporary work
/dist/
/.scratch/
/.presentation-build/

# Locally downloaded third-party papers; retain links and citation notes in Git.
/docs/references/papers/

# Local LaTeX compilation products; preserve the manuscript and vector figures.
/docs/paper/*.aux
/docs/paper/*.bbl
/docs/paper/*.blg
/docs/paper/*.fdb_latexmk
/docs/paper/*.fls
/docs/paper/*.out
/docs/paper/*.synctex.gz
/docs/paper/*.toc
